suppressPackageStartupMessages({
  library(rstan)
  library(dplyr)
  library(readr)
  library(ggplot2)
  library(tidyr)
  library(purrr)
})
rstan_options(auto_write = TRUE)
options(mc.cores = max(1, parallel::detectCores() - 1))

# ---------------- PARAMETERS ----------------
METHOD <- "mcmc"
CHAINS <- 2
ITER <- 1000
WARMUP <- 500
control = list(adapt_delta = 0.99, max_treedepth = 15)
VB_ITER <- 5000
SEED <- 2025
HORIZON <- 1

OUT_DIR <- "outputs"
FIG_DIR <- file.path("figures", "bayes")
dir.create(OUT_DIR, showWarnings = FALSE, recursive = TRUE)
dir.create(FIG_DIR, showWarnings = FALSE, recursive = TRUE)

# ---------------- Choose micro / macro predictor variables (edit as needed) ----------------
# These must be column names in data/df_scores.rds (case-sensitive). If empty, model uses only EFS_lag.
MICRO_VARS <- c(
  "gdp_growth",
  "inflation",
  "business_entry_cost",
  "firm_density",
  "reg_quality",
  "trade_open",
  "fiscal_balance"
)
# example names
# If your dataset has different column names, put them here. The script will drop missing ones.

# ---------------- Load scored panel (produced by your pipeline) ----------------
if (!file.exists("data/df_scores.rds")) stop("Run 2_compute_scores.R first to produce data/df_scores.rds")
df_all <- readRDS("data/df_scores.rds") %>% as_tibble()

# Select EFS column (PCA-weighted preferred)
efs_col <- if ("EFS_pca" %in% names(df_all)) "EFS_pca" else if ("EFS_manual" %in% names(df_all)) "EFS_manual" else if ("EFS_eq" %in% names(df_all)) "EFS_eq" else stop("No EFS column found.")

# Prepare dataset: ensure needed columns exist, create lag, and pick predictor columns present
df <- df_all %>%
  mutate(
    iso = iso,
    country = country,
    year = as.integer(year)
  ) %>%
  select(iso, country, year, all_of(efs_col), everything()) %>%
  rename(EFS = all_of(efs_col)) %>%
  arrange(iso, year) %>%
  group_by(iso) %>%
  mutate(EFS_lag = lag(EFS)) %>%
  ungroup()

# Helper: safe selection operator
`%??%` <- function(x, y) if (y %in% names(df_all)) y else x

# Filter rows with lag (we need lag to model AR(1))
df_model <- df %>% filter(!is.na(EFS) & !is.na(EFS_lag))

# Detect which micro vars are actually present
present_micro <- intersect(MICRO_VARS, names(df_model))
if (length(MICRO_VARS) > 0 && length(present_micro) == 0) {
  message("No specified MICRO_VARS found in data. Running model with only EFS_lag and hierarchical effects.")
}
if (length(present_micro) > 0) message("Using predictors: ", paste(present_micro, collapse = ", "))

# Build design matrix X (center/scale predictors)
if (length(present_micro) > 0) {
  X_df <- df_model %>% select(all_of(present_micro))
  # simple imputation: if NA in predictor, fill with group (iso) mean then global mean
  X_df <- X_df %>% mutate(across(everything(), ~ ifelse(is.na(.), NA_real_, .)))
  # Replace group NA with group mean, then global mean
  tmp <- bind_cols(df_model %>% select(iso), X_df)
  for (col in present_micro) {
    tmp <- tmp %>% group_by(iso) %>%
      mutate(!!col := ifelse(is.na(.data[[col]]), mean(.data[[col]], na.rm=TRUE), .data[[col]])) %>%
      ungroup()
    # fallback fill with global mean
    tmp[[col]] <- ifelse(is.na(tmp[[col]]), mean(tmp[[col]], na.rm=TRUE), tmp[[col]])
  }
  # scale predictors
  X_scaled <- tmp %>% select(all_of(present_micro)) %>% mutate(across(everything(), ~ scale(.)))
  X_matrix <- as.matrix(X_scaled)
  K <- ncol(X_matrix)
} else {
  # No predictors
  X_matrix <- matrix(nrow = nrow(df_model), ncol = 0)
  K <- 0
}

# Re-index countries to integer indices
country_factor <- factor(df_model$iso)
country_index <- as.integer(country_factor)
C <- length(levels(country_factor))
N <- nrow(df_model)

# Create stand data list for Stan
stan_data <- list(
  N = N,
  C = C,
  K = K,
  country = country_index,
  EFS = as.numeric(df_model$EFS),
  EFS_lag = as.numeric(df_model$EFS_lag),
  X = if (K > 0) X_matrix else array(0, dim = c(N, 0))
)

# ---------------- STAN MODEL CODE ----------------
stan_code <- "
data {
  int<lower=1> N;
  int<lower=1> C;
  int<lower=0> K;
  array[N] int<lower=1, upper=C> country;
  vector[N] EFS;
  vector[N] EFS_lag;
  matrix[N, K] X;
}
parameters {
  real alpha_0;
  vector[C] alpha_raw;        // non-centered
  real phi;
  vector[K] beta;
  real<lower=0> sigma;
  real<lower=0> tau;
}
transformed parameters {
  vector[C] alpha_c;
  alpha_c = alpha_0 + tau * alpha_raw;   // non-centered transform
}
model {
  // Priors
  alpha_0   ~ normal(0, 1);
  alpha_raw ~ normal(0, 1);              // standard normal
  if (K > 0) beta ~ normal(0, 1);
  phi       ~ normal(0.8, 0.1);
  sigma     ~ student_t(3, 0, 0.3);
  tau       ~ student_t(3, 0, 0.3);

  // Likelihood
  for (n in 1:N) {
    real xb = 0;
    if (K > 0)
      xb = X[n] * beta;

    EFS[n] ~ normal(
      alpha_c[country[n]] +
      phi * EFS_lag[n] +
      xb,
      sigma
    );
  }
}
generated quantities {
  vector[N] EFS_pred;
  for (n in 1:N)
    EFS_pred[n] = normal_rng(
      alpha_c[country[n]] +
      phi * EFS_lag[n] +
      (K > 0 ? X[n] * beta : 0),
      sigma
    );
}
"

# ---------------- Extract posterior draws and compute predictive summaries ----------------
# We want posterior draws of alpha_c, alpha_0, phi, beta (if present), sigma, tau.
if (tolower(METHOD) == "mcmc") {
  message("Running enhanced MCMC diagnostics and posterior visualizations...")

  # Convert draws to posterior-friendly objects
  draws_array <- as_draws_array(fit$draws())   # draws × chains × variables
  draws_mat   <- as_draws_matrix(fit$draws())  # draws × variables (flattened)

  # Numeric diagnostics (posterior package)
  rhat_vals <- rhat(draws_array)               # array or matrix of Rhat
  ess_bulk_vals <- ess_bulk(draws_array)
  ess_tail_vals <- ess_tail(draws_array)

  # Convert to tidy table for CSV
  diag_df <- data.frame(
    parameter = names(rhat_vals),
    rhat = as.numeric(rhat_vals),
    ess_bulk = as.numeric(ess_bulk_vals),
    ess_tail = as.numeric(ess_tail_vals),
    stringsAsFactors = FALSE
  )
  write_csv(diag_df, file.path(OUT_DIR, paste0("mcmc_diagnostics_method-", METHOD, ".csv")))

  # Quick thresholds for flagging
  diag_df <- diag_df %>%
    mutate(flag_rhat = rhat > 1.01,
           flag_ess  = ess_bulk < 400)

  # Save flagged diagnostics
  write_csv(diag_df %>% filter(flag_rhat | flag_ess),
            file.path(OUT_DIR, paste0("mcmc_diagnostics_flags_method-", METHOD, ".csv")))

  # ---------------- Classic MCMC plots ----------------
  posterior_array <- as_draws_array(fit$draws())  # bayesplot works with arrays

  # Trace + density for core params
  core_pars <- c("alpha_0", "phi", "sigma", "tau")
  png(file.path(FIG_DIR, "mcmc_trace_core.png"), width = 1000, height = 700)
  bayesplot::mcmc_trace(posterior_array, pars = core_pars)
  dev.off()

  png(file.path(FIG_DIR, "mcmc_dens_core.png"), width = 1000, height = 700)
  bayesplot::mcmc_dens_overlay(posterior_array, pars = core_pars)
  dev.off()

  png(file.path(FIG_DIR, "mcmc_acf_core.png"), width = 1000, height = 700)
  bayesplot::mcmc_acf(posterior_array, pars = c("alpha_0", "phi"))
  dev.off()

  png(file.path(FIG_DIR, "mcmc_rank_core.png"), width = 1000, height = 700)
  bayesplot::mcmc_rank_overlay(posterior_array, pars = core_pars)
  dev.off()

  # NUTS energy plot (if available)
  try({
    png(file.path(FIG_DIR, "mcmc_nuts_energy.png"), width = 1000, height = 700)
    bayesplot::mcmc_nuts_energy(posterior_array)
    dev.off()
  }, silent = TRUE)

  # Pairwise scatter for a few params (useful for correlations)
  png(file.path(FIG_DIR, "mcmc_pairs_core.png"), width = 1000, height = 1000)
  bayesplot::mcmc_pairs(posterior_array, pars = core_pars, off_diag_args = list(size = 0.5))
  dev.off()

  # ---------------- Posterior summaries and plots ----------------

  # 1) Caterpillar plot for alpha_c (country intercepts)
  alpha_cols <- grep("^alpha_c\

\[", colnames(draws_mat), value = TRUE)
  if (length(alpha_cols) > 0) {
    alpha_mat <- draws_mat[, alpha_cols, drop = FALSE]   # draws × C
    alpha_summary <- apply(alpha_mat, 2, function(x) {
      c(mean = mean(x), lo = quantile(x, 0.025), hi = quantile(x, 0.975))
    }) %>% t() %>% as.data.frame()
    alpha_summary$iso <- sub("^alpha_c\

\[(\\d+)\\]

$", "\\1", rownames(alpha_summary))
    # map iso index back to factor levels
    alpha_summary$iso <- levels(country_factor)[as.integer(alpha_summary$iso)]
    alpha_summary <- alpha_summary %>% arrange(mean)

    write_csv(alpha_summary, file.path(OUT_DIR, paste0("alpha_c_summary_method-", METHOD, ".csv")))

    png(file.path(FIG_DIR, "alpha_c_caterpillar.png"), width = 1000, height = 1200)
    ggplot(alpha_summary, aes(x = mean, y = reorder(iso, mean))) +
      geom_point(color = "blue") +
      geom_errorbarh(aes(xmin = lo, xmax = hi), height = 0.2, color = "blue", alpha = 0.6) +
      labs(x = "alpha_c (posterior mean and 95% CI)", y = "") +
      theme_minimal()
    dev.off()
  }

  # 2) Coefficient forest plot for beta (if present)
  beta_cols <- grep("^beta\

\[", colnames(draws_mat), value = TRUE)
  if (length(beta_cols) > 0) {
    beta_mat <- draws_mat[, beta_cols, drop = FALSE]
    beta_summary <- apply(beta_mat, 2, function(x) {
      c(mean = mean(x), lo = quantile(x, 0.025), hi = quantile(x, 0.975))
    }) %>% t() %>% as.data.frame()
    beta_summary$term <- paste0("beta", seq_len(nrow(beta_summary)))
    write_csv(beta_summary, file.path(OUT_DIR, paste0("beta_summary_method-", METHOD, ".csv")))

    png(file.path(FIG_DIR, "beta_forest.png"), width = 900, height = 600)
    ggplot(beta_summary, aes(x = mean, y = reorder(term, mean))) +
      geom_point(color = "darkgreen") +
      geom_errorbarh(aes(xmin = lo, xmax = hi), height = 0.2, color = "darkgreen", alpha = 0.6) +
      labs(x = "beta (posterior mean and 95% CI)", y = "") +
      theme_minimal()
    dev.off()
  }

  # 3) Posterior predictive time-series ribbons (observed vs posterior mean + 95% CI)
  # If EFS_pred is in draws (generated quantities), extract it; otherwise compute from draws
  if ("EFS_pred" %in% dimnames(draws_array)$variable) {
    # draws_array: draws × chains × variables; EFS_pred is vector of length N, named "EFS_pred[1]" etc.
    efs_cols <- grep("^EFS_pred\

\[", dimnames(draws_array)$variable, value = TRUE)
    efs_mat <- as_draws_matrix(fit$draws())[, efs_cols, drop = FALSE]  # draws × N
    # summarize per observation
    pred_mean <- apply(efs_mat, 2, mean)
    pred_lo   <- apply(efs_mat, 2, quantile, 0.025)
    pred_hi   <- apply(efs_mat, 2, quantile, 0.975)
  } else {
    # fallback: compute from alpha_c, phi, beta, sigma draws (already available)
    # compute posterior predictive mean only (no noise) for speed
    pred_mean <- rep(NA_real_, N); pred_lo <- rep(NA_real_, N); pred_hi <- rep(NA_real_, N)
    # compute using a subset of draws to save time if ndraws large
    use_draws <- seq(1, nrow(draws_mat), length.out = min(1000, nrow(draws_mat))) %>% unique()
    pred_draws_sub <- matrix(NA_real_, nrow = length(use_draws), ncol = N)
    for (i in seq_along(use_draws)) {
      d <- use_draws[i]
      alpha_vec <- as.numeric(draws_mat[d, alpha_cols])
      phi_d     <- as.numeric(draws_mat[d, "phi"])
      beta_vec  <- if (length(beta_cols) > 0) as.numeric(draws_mat[d, beta_cols]) else numeric(0)
      mu_vec <- alpha_vec[country_index] + phi_d * df_model$EFS_lag
      if (length(beta_cols) > 0) mu_vec <- mu_vec + as.vector(stan_data$X %*% beta_vec)
      pred_draws_sub[i, ] <- mu_vec
    }
    pred_mean <- apply(pred_draws_sub, 2, mean)
    pred_lo   <- apply(pred_draws_sub, 2, quantile, 0.025)
    pred_hi   <- apply(pred_draws_sub, 2, quantile, 0.975)
  }

  df_pp <- df_model %>%
    mutate(EFS_pred_mean = pred_mean,
           EFS_pred_lo   = pred_lo,
           EFS_pred_hi   = pred_hi)

  write_csv(df_pp, file.path(OUT_DIR, paste0("efs_bayes_posterior_summary_method-", METHOD, ".csv")))

  # Plot a sample of countries with ribbons
  set.seed(SEED)
  sample_isos <- sample(unique(df_model$iso), size = min(6, length(unique(df_model$iso))))
  for (iso_code in sample_isos) {
    sub <- df_pp %>% filter(iso == iso_code)
    pfile <- file.path(FIG_DIR, paste0(iso_code, "_posterior_ribbon.png"))
    png(pfile, width = 1000, height = 600)
    ggplot(sub, aes(x = year)) +
      geom_ribbon(aes(ymin = EFS_pred_lo, ymax = EFS_pred_hi), fill = "lightblue", alpha = 0.4) +
      geom_line(aes(y = EFS_pred_mean), color = "blue", size = 1) +
      geom_point(aes(y = EFS), color = "black") +
      geom_line(aes(y = EFS), color = "black", linetype = "dashed", alpha = 0.6) +
      labs(title = paste0(sub$country[1], " (", iso_code, ") - observed vs posterior"),
           y = "EFS", x = "Year") +
      theme_minimal()
    dev.off()
  }

  message("Enhanced diagnostics and plots saved to figures/bayes/ and outputs/")
}


